# Copy into Streamlit Cloud: App menu → Settings → Secrets
# Do not commit a real secrets.toml.

# One OpenRouter key covers paid chat, embeddings, and rerank.
# Get a key at https://openrouter.ai/keys (needs credit).
LLM_PROVIDER = "openrouter"
OPENROUTER_API_KEY = "sk-or-..."
OPENROUTER_CHAT_MODEL = "qwen/qwen3.8-flash"

EMBEDDING_PROVIDER = "openrouter"
OPENROUTER_EMBEDDING_MODEL = "openai/text-embedding-3-small"

# Optional paid OpenAI embeddings instead:
# EMBEDDING_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."
# OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"

USE_RERANKER = "true"
RERANKER_MODEL = "cohere/rerank-4-fast"
LANGSMITH_TRACING = "false"

# Credit caps (each tester / shared app)
DEMO_MAX_QUERIES_PER_SESSION = "5"
DEMO_MAX_QUERIES_PER_DAY = "40"
DEMO_MAX_QUERY_CHARS = "400"
# Passphrase lock (Cloud default is cirse2026 if this line is omitted).
# Set to "off" to make the app public.
DEMO_ACCESS_CODE = "cirse2026"
