# Copy into Streamlit Cloud: App menu → Settings → Secrets
# Do not commit a real secrets.toml.

# One OpenRouter key covers free chat AND free embeddings.
# Get a key at https://openrouter.ai/keys
LLM_PROVIDER = "openrouter"
OPENROUTER_API_KEY = "sk-or-..."
OPENROUTER_CHAT_MODEL = "nvidia/nemotron-3.5-lightning:free"

EMBEDDING_PROVIDER = "openrouter"
OPENROUTER_EMBEDDING_MODEL = "nvidia/nemotron-3-embed-1b:free"
# Other OpenRouter :free embedding slugs:
#   liquid/lfm-2.5-embedding-350m:free
#   nvidia/llama-nemotron-embed-vl-1b-v2:free   (multimodal; not needed here)

# Optional paid OpenAI embeddings instead:
# EMBEDDING_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."
# OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"

USE_RERANKER = "false"
LANGSMITH_TRACING = "false"

# Credit caps (each tester / shared app)
DEMO_MAX_QUERIES_PER_SESSION = "5"
DEMO_MAX_QUERIES_PER_DAY = "40"
DEMO_MAX_QUERY_CHARS = "400"
# Passphrase lock (Cloud default is cirse2026 if this line is omitted).
# Set to "off" to make the app public.
DEMO_ACCESS_CODE = "cirse2026"
