# Copy into Streamlit Cloud: App menu → Settings → Secrets
# Do not commit a real secrets.toml.

# Embeddings (required on Cloud — local Ollama is not available)
OPENAI_API_KEY = "sk-..."
EMBEDDING_PROVIDER = "openai"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"

# Chat model: OpenRouter free open-weight endpoints (local-capability demo)
# The Streamlit sidebar lets testers switch among the catalog in
# src/openrouter_demo_models.py. This value is the default.
LLM_PROVIDER = "openrouter"
OPENROUTER_API_KEY = "sk-or-..."
OPENROUTER_CHAT_MODEL = "nvidia/nemotron-3.5-lightning:free"

# Or use OpenAI for chat instead:
# LLM_PROVIDER = "openai"
# OPENAI_CHAT_MODEL = "gpt-4o-mini"

USE_RERANKER = "false"
LANGSMITH_TRACING = "false"

# Credit caps (each tester / shared app)
DEMO_MAX_QUERIES_PER_SESSION = "5"
DEMO_MAX_QUERIES_PER_DAY = "40"
DEMO_MAX_QUERY_CHARS = "400"
# Passphrase lock (Cloud default is cirse2026 if this line is omitted).
# Set to "off" to make the app public.
DEMO_ACCESS_CODE = "cirse2026"
